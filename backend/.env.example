# Application Environment
APP_ENV=production

# Network & Server Binding
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Canonical Deep Learning Checkpoint & Verification
MODEL_PATH=result/30_proposed/three_stage_split0_research_20260819-211511/phase3/split_0/best_model.pt
MODEL_HASH=6c10366505db80367e53c400bfddaacada0a0df004b07a87bdfbf6dc0816846c

# Inference Hardware Target: auto, cuda, mps, cpu
DEVICE=auto

# Operational Limits & Security Guardrails
