# ==============================================================================
# CystoDS Research Platform — Unified Environment Configuration Template
# Conforms to Docs/CystoDS_Website_Detailed_Implementation_Plan.md §13.2
# ==============================================================================

# Application Environment (production, staging, development, offline)
APP_ENV=production

# ------------------------------------------------------------------------------
# Backend Service Configuration (FastAPI)
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Canonical Deep Learning Checkpoint Path & Cryptographic SHA-256 Hash
MODEL_PATH=result/30_proposed/three_stage_split0_research_20260819-211511/phase3/split_0/best_model.pt
MODEL_HASH=6c10366505db80367e53c400bfddaacada0a0df004b07a87bdfbf6dc0816846c

# Compute Device Preference: 'auto' (detects CUDA -> Apple Silicon MPS -> CPU), 'cuda', 'mps', or 'cpu'
DEVICE=auto

# Security & Traffic Hardening Guardrails
# 10 MB = 10 * 1024 * 1024 bytes
MAX_UPLOAD_BYTES=10485760
MAX_CONCURRENT_INFERENCE=2
REQUEST_TIMEOUT_SECONDS=30

# Curated Clinical Endoscopy Reference Samples Directory
DEMO_SAMPLES_DIR=xvdhy-osfstorage-archive/images

# ------------------------------------------------------------------------------
# Frontend Application Configuration (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
PORT_FRONTEND=3000
